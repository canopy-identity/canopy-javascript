{
  "name": "@canopy-io/javascript",
  "private": true,
  "description": "Official Canopy SDKs for JavaScript and TypeScript.",
  "license": "MIT",
  "author": "Canopy Identity Inc.",
  "homepage": "https://github.com/canopy-identity/canopy-javascript#readme",
  "bugs": "https://github.com/canopy-identity/canopy-javascript/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canopy-identity/canopy-javascript.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "npm run generate --workspaces --if-present",
    "generate:check": "npm run generate:check --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run generate:check && npm run test && npm run build",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "volta": {
    "node": "20.19.0",
    "npm": "10.8.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.2",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
