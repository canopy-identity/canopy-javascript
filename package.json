{
  "name": "@canopy-io/javascript",
  "private": true,
  "description": "Official Canopy SDKs for JavaScript and TypeScript.",
  "license": "MIT",
  "author": "Canopy Identity Inc.",
  "homepage": "https://github.com/canopy-identity/canopy-javascript#readme",
  "bugs": "https://github.com/canopy-identity/canopy-javascript/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canopy-identity/canopy-javascript.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npm run build --workspace @canopy-io/node && npm run build --workspace @canopy-io/nestjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "npm run generate --workspaces --if-present",
    "check:packaging": "attw --pack packages/node && attw --pack packages/nestjs",
    "generate:check": "npm run generate:check --workspaces --if-present",
    "check:skill": "node scripts/check-skill-snippets.mjs",
    "verify": "npm run build && npm run lint && npm run typecheck && npm run generate:check && npm run check:skill && npm run test",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "volta": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@nestjs/config": "4.0.4",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "fastify": "5.12.7",
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
