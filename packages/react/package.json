{
  "name": "@canopy-io/react",
  "version": "0.1.0",
  "description": "Official React SDK for Canopy: a provider, hooks and components over @canopy-io/browser for signing a single-page app in through Canopy's hosted login and deciding what it shows.",
  "license": "MIT",
  "author": "Canopy Identity Inc.",
  "homepage": "https://github.com/canopy-identity/canopy-javascript#readme",
  "bugs": "https://github.com/canopy-identity/canopy-javascript/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canopy-identity/canopy-javascript.git",
    "directory": "packages/react"
  },
  "keywords": [
    "canopy",
    "react",
    "hooks",
    "oauth",
    "oidc",
    "pkce",
    "spa",
    "authentication",
    "authorization",
    "permissions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@canopy-io/browser": "^0.5.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
