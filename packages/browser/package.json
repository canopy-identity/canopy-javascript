{
  "name": "@canopy-io/browser",
  "version": "0.1.0",
  "description": "Official browser SDK for Canopy: sign a single-page app in through Canopy's hosted login as a public OAuth client.",
  "license": "MIT",
  "author": "Canopy Identity Inc.",
  "homepage": "https://github.com/canopy-identity/canopy-javascript#readme",
  "bugs": "https://github.com/canopy-identity/canopy-javascript/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canopy-identity/canopy-javascript.git",
    "directory": "packages/browser"
  },
  "keywords": [
    "canopy",
    "oauth",
    "oidc",
    "pkce",
    "spa",
    "single-page-app",
    "authentication",
    "identity",
    "browser"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
